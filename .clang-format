---
Language: Cpp

BasedOnStyle: Microsoft

IndentWidth: 4
ColumnLimit: 100
AlignAfterOpenBracket: AlwaysBreak
AlignOperands: DontAlign
AlignArrayOfStructures: Left
AlignEscapedNewlines: DontAlign
AllowAllArgumentsOnNextLine: true
AllowAllConstructorInitializersOnNextLine: true
AllowAllParametersOfDeclarationOnNextLine: true
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortEnumsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: false
AllowShortLoopsOnASingleLine: false
PenaltyReturnTypeOnItsOwnLine: 1024
PenaltyBreakBeforeFirstCallParameter: 0
BreakAfterOpenBracketFunction: true
BreakAfterOpenBracketIf: true
BreakAfterOpenBracketLoop: true
BreakAfterOpenBracketSwitch: true
BreakBeforeCloseBracketBracedList: false
BreakBeforeCloseBracketFunction: true
BreakBeforeCloseBracketIf: true
BreakBeforeCloseBracketLoop: true
BreakBeforeCloseBracketSwitch: true
BreakFunctionDefinitionParameters: true
BracedInitializerIndentWidth: 4
BreakBeforeBinaryOperators: None


PackConstructorInitializers: CurrentLine
ConstructorInitializerIndentWidth: 4
ContinuationIndentWidth: 4

BreakAfterReturnType: None
UseTab: Never
IndentWrappedFunctionNames: true
RequiresExpressionIndentation: OuterScope
IndentCaseBlocks: true
IndentCaseLabels: false
AlwaysBreakAfterReturnType: None
AlwaysBreakAfterDefinitionReturnType: None
SpaceBeforeParens: Never

RequiresClausePosition: OwnLine

AccessModifierOffset: -4

SortIncludes: 
  Enabled: false
PackParameters:
  BinPack: OnePerLine
BinPackArguments: true
BinPackParameters: AlwaysOnePerLine
BinPackLongBracedList: true
BitFieldColonSpacing: None
BreakBeforeBraces: Custom
InsertBraces: true

ConstructorInitializerAllOnOneLineOrOnePerLine: true

# BreakAfterAttributes: Always
BreakAfterAttributes: Always
BreakBeforeReturnType: All
StatementMacros:
  - OgMacroCBlockBegin 
  - OgMacroCBlockEnd 
  - __capability
  - __output
  - __ununsed

WhitespaceSensitiveMacros:
  - OgMacroGNU 
  - OgMacroMsvc

AttributeMacros:
  - __capability
  - __output
  - __ununsed
  - __forceinline
  - OgAttrRestrict
  - OgAttrRegister
  - OgMacroGnuAttribute
  - OgMacroGnu
  - OgMacroSinceAnsiC
  - OgMacroSinceC95
  - OgMacroSinceC99
  - OgMacroSinceC11
  - OgMacroSinceC17
  - OgMacroSinceC23
  - OgMacroC23Attribute
  - OgMacroMsvc

# Macros:
  # - OgMacroSinceAnsiC(Expression)= Expression
  # - OgMacroSinceC95(Expression)= Expression
  # - OgMacroSinceC99(Expression)= Expression
  # - OgMacroSinceC11(Expression)= Expression
  # - OgMacroSinceC17(Expression)= Expression
  # - OgMacroSinceC23(Expression)= Expression
  # - OgMacroC23Attribute(Expression)=[[Expression]]
  # - OgMacroMsvc(Expression)= Expression
  # - OgMacroGnuAttribute(Arg0)=__attribute__((Arg0))
  # - OgMacroGnuAttribute(Arg0,Arg1)=__attribute__((Arg0,Arg1))
  # - OgMacroGnuAttribute(Arg0,Arg1,Arg2)=__attribute__((Arg0,Arg1,Arg2))
  # - OgMacroGnuAttribute(Arg0,Arg1,Arg2,Arg3)=__attribute__((Arg0,Arg1,Arg2,Arg3))
  # - OgMacroGnuAttribute(Arg0,Arg1,Arg2,Arg3,Arg4)=__attribute__((Arg0,Arg1,Arg2,Arg3,Arg4))



BraceWrapping:
  AfterCaseLabel: true
  AfterClass: true
  AfterControlStatement: Always
  AfterEnum: true
  AfterExternBlock: true
  AfterFunction: true
  AfterNamespace: true
  AfterObjCDeclaration: true
  AfterStruct: true
  AfterUnion: true
  BeforeCatch: true
  BeforeElse: true
  BeforeLambdaBody: false
  BeforeWhile: false
  IndentBraces: false
  SplitEmptyFunction: true
  SplitEmptyRecord: true
  SplitEmptyNamespace: true

---
Language: Json
IndentWidth: 4

